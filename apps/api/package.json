{
  "name": "@fuel-queue/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "pnpm --filter @fuel-queue/config build && pnpm --filter @fuel-queue/shared-types build",
    "build": "nest build",
    "predev": "pnpm --filter @fuel-queue/config build && pnpm --filter @fuel-queue/shared-types build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --filter @fuel-queue/shared-types build",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "migration:generate": "DATABASE_URL=${DATABASE_URL:-postgresql://fuel_queue:fuel_queue@localhost:5433/fuel_queue} prisma migrate dev",
    "migration:deploy": "DATABASE_URL=${DATABASE_URL:-postgresql://fuel_queue:fuel_queue@localhost:5433/fuel_queue} prisma migrate deploy",
    "prisma:generate": "DATABASE_URL=${DATABASE_URL:-postgresql://fuel_queue:fuel_queue@localhost:5433/fuel_queue} prisma generate",
    "prisma:validate": "DATABASE_URL=${DATABASE_URL:-postgresql://fuel_queue:fuel_queue@localhost:5433/fuel_queue} prisma validate"
  },
  "dependencies": {
    "@fuel-queue/config": "workspace:*",
    "@fuel-queue/shared-types": "workspace:*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/client": "^6.7.0",
    "ioredis": "^5.6.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "nestjs-pino": "^4.4.0",
    "pino": "^9.7.0",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@nestjs/testing": "^11.1.0",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/pg": "^8.15.2",
    "jest": "^29.7.0",
    "prisma": "^6.7.0",
    "ts-jest": "^29.3.2",
    "ts-node": "^10.9.2"
  }
}
